generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider            = "prisma-dbml-generator"
  output              = "../dbml"
  outputName          = "stay-permit.dbml"
  projectDatabaseType = "PostgreSQL"
  projectName         = "Stay Permit"
  projectNote         = "Stay Permit DB Schema"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id              Int               @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String            @unique
  phone           String            @unique
  password        String
  role            Role              @default(ADMIN)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?         @db.Timestamp(6)
  username        String?           @unique  

  @@index([email])
  @@index([createdAt])
  @@index([updatedAt])
}
model profile {
  id                 Int              @id @default(autoincrement())
  barcode            BigInt?
  firstName          String
  lastName           String
  phoneNumber        String?
  dateOfBirth        DateTime
  gender             String
  nationalityId      Int
  ethnicityId        Int
  identityType       String?
  identityNumber     String?
  identityIssueDate  DateTime?
  identityExpiryDate DateTime?
  currentProvince    Int?
  currentDistrict    Int?
  overseasCountryId  Int?
  overseasProvince   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?        @db.Timestamp(6)
  officeId           Int?
  currentVillageId   Int?
  image              String?
  oldImage           String?
  district           district?        @relation(fields: [currentDistrict], references: [id], onDelete: Restrict)
  province           province?        @relation(fields: [currentProvince], references: [id], onDelete: Restrict)
  currentVillage     village?  @relation(fields: [currentVillageId], references: [id], onDelete: Restrict)
 
  @@index([nationalityId])
  @@index([ethnicityId])
  @@index([currentProvince])
  @@index([currentDistrict])
  @@index([officeId])
  @@index([createdAt])
  @@index([updatedAt])
}
model province {
  id              Int        @id
  provinceLao     String
  provinceEnglish String
  status          Boolean    @default(true)
  district        district[]
  profile         profile[]

  @@index([provinceLao])
  @@index([provinceEnglish])
}

model district {
  id              Int       @id @default(autoincrement())
  districtLao     String
  districtEnglish String
  provinceId      Int
  status          Boolean   @default(true)
  province        province  @relation(fields: [provinceId], references: [id])
  profile         profile[]
  village         village[]

  @@index([provinceId])
  @@index([districtLao])
  @@index([districtEnglish])
}

model village {
  id          Int           @id @default(autoincrement())
  villageLao  String
  districtId  Int
  status      Boolean       @default(true)
  profile     profile[]
  district    district      @relation(fields: [districtId], references: [id])
}
enum folderType {
  YELLOW
  BLUE
}

enum processStatus {
  DEFAULT
  PENDING
  APPROVED_BY_POLICE
  FINANCE_UNDER_REVIEW
  POLICE_UNDER_REVIEW
  IN_PRODUCTION
  FINISHED
  REJECTED
  REJECTED_BY_COMMANDER
  APPROVED_BY_PROVINCE
  APPROVED_BY_HQ
}

enum applicationStatus {
  DEFAULT
  APPROVED
  PROCESS
  FINISHED
}

enum applicationType {
  NEW
  RENEW
}

enum Role {
  ADMIN
  USER
  FINANCE
  POLICE_OFFICER
  POLICE_COMMANDER
  POLICE_PRODUCTION
  VERSIFICATION_OFFICER
  SUPER_ADMIN
  POLICE_COMMANDER_PROVINCE

  @@map("Role")
}

enum Gender {
  MALE
  FEMALE
}

enum PaymentMethod {
  CASH
  MONEY_TRANSFER
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  PATCH
}

enum FolderRejectStatus {
  PENDING
  APPROVED
  REJECTED
}

enum applicationDependBy {
  COMPANY
  VILLAGE
}
